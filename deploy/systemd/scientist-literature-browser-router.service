[Unit]
Description=Scientist publisher-aware literature browser router
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hdagent
Group=hdagent
EnvironmentFile=/etc/scientist-literature-browser-router.env
WorkingDirectory=/opt/scientist-literature-router/current
ExecStart=/usr/bin/python3 -m scientist_literature_mcp.browser_router
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
