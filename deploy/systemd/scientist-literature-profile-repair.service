[Unit]
Description=Scientist literature profile repair pool
Requires=scientist-literature-cluster.service
After=scientist-literature-cluster.service

[Service]
Type=oneshot
User=scientist-literature
Group=scientist-literature
EnvironmentFile=/etc/scientist-literature/cluster.env
StateDirectory=scientist-literature-profile-repair scientist-literature-fleet
StateDirectoryMode=0750
Environment=PYTHONPATH=/opt/scientist-literature/current/src
Environment=SCIENTIST_LITERATURE_POOL_ADMIN_TOKEN_FILE=/data/scientist/literature/private/admin-token
Environment=SCIENTIST_LITERATURE_FLEET_LOCK=/var/lib/scientist-literature-fleet/fleet.lock
Environment=LITERATURE_PROFILE_REPAIR_MODE=engine
Environment=LITERATURE_PROFILE_REPAIR_WORKERS=10
Environment=LITERATURE_PROFILE_VERIFICATION_SLOTS=2
Environment=LITERATURE_PROFILE_MUTATION_SLOTS=2
WorkingDirectory=/opt/scientist-literature/current
ExecStart=/usr/bin/python3 -m scientist_literature_mcp.maintenance.profile_repair --repo /opt/scientist-literature/current --state /var/lib/scientist-literature-profile-repair/state.json
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/scientist-literature/current /etc/scientist-literature /data/scientist/literature/private
ReadWritePaths=/var/lib/scientist-literature-profile-repair /var/lib/scientist-literature-fleet
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
